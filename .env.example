# Токен бота от @BotFather
BOT_TOKEN=
# Ваш числовой Telegram ID (узнать: написать @userinfobot)
OWNER_ID=

# --- Нейросеть: заполните ОДИН из вариантов ---
# GigaChat (Сбер): developers.sber.ru → проект GigaChat API → ключ авторизации
GIGACHAT_AUTH_KEY=
# YandexGPT (aistudio.yandex.ru)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# --- Локальная модель на вашем компьютере (необязательно) ---
# Адрес Ollama через Tailscale. Пока компьютер доступен — бот работает через неё,
# когда он спит — через нейросеть выше.
# LOCAL_LLM_URL=http://100.x.y.z:11434/v1
# LOCAL_LLM_MODEL=qwen3.5:9b

# Необязательно
TZ_NAME=Europe/Moscow
# Модели для разбора сообщений и для сводок.
# GigaChat: GigaChat-2 (Lite), GigaChat-2-Pro, GigaChat-2-Max
# LLM_MODEL=GigaChat-2
# SUMMARY_MODEL=GigaChat-2-Pro
DEBOUNCE_SECONDS=20
MAX_AUTOREPLIES_PER_HOUR=2
